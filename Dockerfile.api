# Backend: builds the C++ simulator into a Python module, then serves the API.
FROM python:3.12-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends g++ cmake make && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY f1sim f1sim
COPY cpp cpp
RUN cmake -S cpp -B cpp/build -DBUILD_TESTS=OFF && cmake --build cpp/build -j

FROM python:3.12-slim
WORKDIR /app
COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /app/f1sim f1sim
COPY api api
COPY results results
ENV PREDICTIONS=/app/results/predictions.json
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
